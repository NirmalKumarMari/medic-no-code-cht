{
  "name": "@vera/review-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "local:setup": "tsx scripts/setup-local.ts",
    "demo:accounts": "tsx scripts/make-demo-accounts.ts"
  },
  "dependencies": {
    "@vera/review-model": "0.1.0",
    "@vera/artifact-storage": "0.1.0",
    "@vera/workflow-data": "0.1.0",
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@aws-sdk/lib-dynamodb": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/client-bedrock-runtime": "3.1161.0",
    "fastify": "^5.0.0",
    "aws-jwt-verify": "^5.0.0",
    "zod": "4.6.7",
    "@aws-sdk/client-sfn": "3.1161.0"
  }
}
