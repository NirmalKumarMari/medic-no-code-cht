# Export these variables or use Node's --env-file option when starting dist/server.js.
# Local preview: use root npm run review:local:api instead; AWS configuration is not needed.
REVIEW_MODE=aws
REVIEW_HOST=127.0.0.1
REVIEW_PORT=3001
AWS_REGION=us-west-2
WORKFLOW_TABLE_PREFIX=vera-workflow
WORKFLOW_ARTIFACT_BUCKET=
KMS_KEY_ARN=
GUARDRAIL_ID=
GUARDRAIL_VERSION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# JSON mapping verified Cognito sub values to allowed tenant IDs; server-owned.
REVIEW_TENANT_MEMBERSHIPS={}
# Comma-separated exact browser origins, including the public workshop URL if used.
REVIEW_ALLOWED_ORIGINS=
# Local-only optional overrides (AWS mode rejects a DYNAMODB_ENDPOINT override):
# DYNAMODB_ENDPOINT=http://127.0.0.1:18000
# REVIEW_LOCAL_ARTIFACT_DIR=.local/review-artifacts

# Shared demo account; DynamoDB and S3 remain enabled.
REVIEW_AUTH_MODE=demo
REVIEW_DEMO_TENANT=workshop-049197632966

# TEMPORARY demo sign-in instead: see "Temporary password sign-in" in the README.
# REVIEW_AUTH_MODE=password
# REVIEW_DEMO_ACCOUNTS=
