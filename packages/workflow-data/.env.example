AWS_REGION=us-west-2
WORKFLOW_TABLE_PREFIX=vera-workflow
CHANGES_TABLE=vera-workflow-Changes
APPROVALS_TABLE=vera-workflow-Approvals
AUDIT_TABLE=vera-workflow-Audit
TOKENS_TABLE=vera-workflow-Tokens
# Explicit configured tenant IDs, comma-separated. Set when the application creates its tenants.
WORKFLOW_TENANT_IDS=
# Teammate supplies the versioned application artifact bucket; never put AWS keys here.
WORKFLOW_ARTIFACT_BUCKET=
