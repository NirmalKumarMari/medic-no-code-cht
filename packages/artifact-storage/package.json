{
  "name": "@vera/artifact-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "import": "./dist/src/contracts.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1161.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "zod": "4.6.7"
  }
}
