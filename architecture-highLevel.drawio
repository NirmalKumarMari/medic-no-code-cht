        <mxCell id="band" value="AWS Step Functions orchestrates all 8 stages  ·  fixed states  ·  waits for a human at Gate 1 and Gate 2" style="rounded=0;arcSize=6;whiteSpace=nowrap;fillColor=#FADBEA;strokeColor=#E7157B;strokeWidth=2;dashed=0;fontSize=22;fontStyle=1;fontColor=#232F3E;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="3380" height="70" as="geometry" /></mxCell>
        <mxCell id="rails" value="Safety rails built into the design&#10;AI only drafts: every agent input is screened by Bedrock Guardrails, and AgentCore's Cedar policy denies approve / deploy / write-config tools.&#10;Code checks every rule  ·  humans approve twice  ·  only the Deployer ever reads the CHT credentials, and only after Gate 2  ·  nothing generative reaches a phone." style="rounded=1;arcSize=6;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=3;dashed=0;fontSize=21;fontStyle=0;fontColor=#232F3E;fontFamily=Helvetica;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="3380" height="150" as="geometry" /></mxCell>
