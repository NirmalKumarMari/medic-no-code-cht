# Copy to .env.local for local dev (never commit a real .env).

AWS_REGION=us-west-2
PORT=8081

# Bedrock
INTAKE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
INTAKE_ESCALATION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20251001-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Storage
SPECS_S3_BUCKET=medic-nocode-specs-local
SPECS_S3_PREFIX=specs/
CHANGES_TABLE_NAME=Changes

# Bounds (one non-looping call on the happy path; no tool loop — ADR-010/011)
INTAKE_MAX_SCHEMA_REPAIR_ATTEMPTS=2
