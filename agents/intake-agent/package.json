{
  "name": "@vera/agent-intake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "Intake Agent: turns an officer request into a schema-validated StructuredSpec. One non-looping Bedrock call, no tools (design §7, ADR-010/011).",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.709.0",
    "@aws-sdk/client-dynamodb": "^3.709.0",
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/lib-dynamodb": "^3.709.0",
    "@vera/schemas": "0.1.0",
    "fastify": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
