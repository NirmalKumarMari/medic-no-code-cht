{
  "name": "@vera/agent-change-planner",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Change Planner Agent: turns a plain-language edit request against an approved snapshot into a schema-validated ChangePlan. Must-have for the edit journey, per the Agent Roster (design doc section 7).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "npm run build && node dist/demo.js",
    "contracts": "npm run build && node dist/export-contracts.js",
    "check": "tsc --build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "fastify": "^5.0.0",
    "ulid": "^2.3.0",
    "zod": "4.6.7",
    "@vera/schemas": "0.1.0",
    "@vera/workflow-data": "0.1.0",
    "@vera/artifact-storage": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  }
}
